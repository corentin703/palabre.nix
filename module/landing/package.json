{
  "name": "palabre-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Public landing page (anonymous room creation/joining) for PlugNMeet (palabre.nix)",
  "license": "MIT",
  "main": "dist/server/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "start": "node dist/server/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "plugnmeet-sdk-js": "2.2.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
